{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mcpfs/mcpfs/shared/schema.json",
  "title": "mcpfs-schema",
  "type": "object",
  "definitions": {
    "McpServerStdio": {
      "type": "object",
      "required": ["command"],
      "properties": {
        "command": {"type": "string"},
        "args": {"type": "array", "items": {"type": "string"}},
        "env": {"type": "object", "additionalProperties": {"type": "string"}},
        "type": {"type": "string", "enum": ["stdio"]}
      }
    },
    "McpServerHttp": {
      "type": "object",
      "required": ["url"],
      "properties": {
        "url": {"type": "string", "format": "uri"},
        "headers": {"type": "object", "additionalProperties": {"type": "string"}},
        "type": {"type": "string", "enum": ["http", "sse"]}
      }
    },
    "ClientConfig": {
      "type": "object",
      "patternProperties": {
        "^[a-zA-Z0-9._-]+$": {
          "oneOf": [
            {"$ref": "#/definitions/McpServerStdio"},
            {"$ref": "#/definitions/McpServerHttp"}
          ]
        }
      }
    }
  }
}
